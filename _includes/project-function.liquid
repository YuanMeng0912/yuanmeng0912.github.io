    </figure>
    <figure class="fig-full">
      <div class="plate"><a class="figure-link" href="{{ '/assets/img/projects/sensing-place-function/poverty_greenery-perception.jpg' | relative_url }}" target="_blank" rel="noopener"><img src="{{ '/assets/img/projects/sensing-place-function/poverty_greenery-perception.jpg' | relative_url }}" alt="Map of the study area with sampled street locations colored by the number of greenery pixels measured in street view imagery" width="1361" height="1653" loading="eager" decoding="async"></a></div>
