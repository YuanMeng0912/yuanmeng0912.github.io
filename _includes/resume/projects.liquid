<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign projects = data[1] | sort: 'startDate' %}
  {% for content in projects %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% if content.startDate %}
            {% assign startDate = content.startDate | split: '-' | first %}
            {% assign endDate = content.endDate | split: '-' | first | default: 'Present' %}
            {% capture date %}{{ startDate }} &ndash; {{ endDate }}{% endcapture %}
          {% else %}
            {% assign date = '' %}
          {% endif %}
          <span class="badge font-weight-bold danger-color-dark align-middle">{{ date }}</span>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0 project-details">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if content.url %}
              <a href="{{ content.url }}">{{ content.name }}</a>
            {% else %}
              {{ content.name }}
            {% endif %}
          </h6>
          <p class="project-summary ml-1 ml-md-4">{{ content.summary }}</p>
          <ul class="items">
            {% for item in content.highlights %}
              <li>
                <span class="item">{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
